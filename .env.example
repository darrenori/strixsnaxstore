# ============================================================================
# STRIX Snax Store — environment
# Copy to .env and fill in. NEVER commit .env; it is gitignored.
# ============================================================================

NODE_ENV=development
PORT=3000

# Public https origin the Mini App is served from.
# Telegram refuses to open a Mini App over plain http, so in local development
# use a tunnel (ngrok / cloudflared) and paste its https URL here.
PUBLIC_URL=https://your-app.onrender.com

# ---------------------------------------------------------------------------
# Telegram — @BotFather → /newbot, then /mybots → Bot Settings
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-own-token

# Long polling is the default and needs no extra setup. To use a webhook
# instead, set all three of these.
TELEGRAM_USE_WEBHOOK=false
TELEGRAM_WEBHOOK_URL=https://your-app.onrender.com/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=generate-a-long-random-string

# How long a Mini App session stays valid, in seconds (default 24h).
TELEGRAM_INITDATA_MAX_AGE=86400

# ---------------------------------------------------------------------------
# Supabase — Project Settings → API
# ---------------------------------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Service role key. Server-side ONLY — it bypasses row level security and must
# never be shipped to the browser. The Mini App never receives a Supabase key.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Private bucket holding PayNow screenshots (created by schema.sql).
SUPABASE_PROOF_BUCKET=payment-proofs

# Direct Postgres URI, used by `npm run db:setup` only.
# Project Settings → Database → Connection string → URI
SUPABASE_DB_URL=postgresql://postgres.xxxx:password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# ---------------------------------------------------------------------------
# Admins
# ---------------------------------------------------------------------------
# Telegram numeric ids that are always admins. Send /id to the bot to find
# yours. After the first admin exists, everyone else is promoted in-app.
ADMIN_TELEGRAM_IDS=

# ---------------------------------------------------------------------------
# Google Sheets collation
# Google Cloud console → IAM → Service Accounts → create → keys → JSON.
# Enable the Google Sheets API and the Google Drive API on the project, then
# share your spreadsheet with the service-account email as an Editor.
# ---------------------------------------------------------------------------
SHEETS_ENABLED=true
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=snax-store@your-project.iam.gserviceaccount.com
# Keep the surrounding quotes and the literal \n escapes exactly as they
# appear in the JSON key file.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------------------
# PayNow
# ---------------------------------------------------------------------------
# With a proxy set, every order gets its own QR with the amount and the order
# code already filled in. Leave PAYNOW_PROXY_VALUE blank to fall back to the
# static QR image at public/assets/paynow-static.png.
PAYNOW_PROXY_TYPE=mobile          # 'mobile' or 'uen'
PAYNOW_PROXY_VALUE=               # +6591234567  or  202012345K
PAYNOW_MERCHANT_NAME=STRIX SNAX STORE
PAYNOW_AMOUNT_EDITABLE=false      # false locks the amount in the payer's app

# How long an unpaid order holds its stock lives in the database, not here:
# the `order_expiry_minutes` row in the `settings` table (default 45).

# ---------------------------------------------------------------------------
# Store
# ---------------------------------------------------------------------------
STORE_NAME=STRIX Snax Store
STORE_AY=AY2026/2027
MAX_UPLOAD_BYTES=10485760
LOG_LEVEL=info
