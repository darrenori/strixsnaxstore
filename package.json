{
  "name": "strix-snax-store",
  "version": "1.0.0",
  "private": true,
  "description": "STRIX Snax Store - Telegram bot + Mini App storefront with Supabase backend, PayNow payment verification and Google Sheets collation.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "scripts": {
    "setup": "node scripts/setup.js",
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "seed": "node scripts/setup-db.js --seed-only",
    "sheets:creds": "node scripts/sheets-credentials.js",
    "sheets:bootstrap": "node scripts/bootstrap-sheets.js",
    "sheets:link": "node scripts/link-sheet.js",
    "sheets:sync": "node scripts/sync-sheets.js",
    "check": "node scripts/lint-syntax.js && npm test && npm run test:local",
    "db:setup": "node scripts/setup-db.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node tests/e2e.integration.mjs",
    "test:vercel": "node tests/vercel.integration.mjs",
    "test:local": "node scripts/test-local.js",
    "test:flows": "node tests/flows.integration.mjs",
    "test:bot": "node tests/bot.integration.mjs",
    "vercel:env": "node scripts/vercel-env.js"
  },
  "dependencies": {
    "@googleapis/drive": "^22.0.0",
    "@googleapis/sheets": "^14.0.0",
    "@supabase/supabase-js": "^2.45.4",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "multer": "^2.3.0",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "telegraf": "^4.16.3",
    "zod": "^3.23.8"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11"
  }
}
